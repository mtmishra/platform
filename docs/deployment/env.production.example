# LeapMoney Platform — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .env.local in each app directory and populate with real values.
# NEVER commit .env.local files. These are PRODUCTION values — use separate
# configs for staging. All infrastructure must be in ap-south-1 (AWS Mumbai)
# per the DPDP Act 2023 data-residency requirement.

# ─── Supabase (hosted in ap-south-1) ─────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key
# Server-side only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# ─── Database (server-side only) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ─── Site URLs (unique per Vercel project / portal) ──────────────────────────
# web:      https://leapmoney.net
# borrower: https://app.leapmoney.net
# dsa:      https://dsa.leapmoney.net
# lender:   https://lender.leapmoney.net
# admin:    https://admin.leapmoney.net
NEXT_PUBLIC_SITE_URL=https://leapmoney.net

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys (use rzp_live_* in production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-live-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Analytics ────────────────────────────────────────────────────────────────
# GA4 Dashboard → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Redis (rate limiting, session cache) ─────────────────────────────────────
# Must be hosted in ap-south-1 (Upstash / ElastiCache Mumbai)
REDIS_URL=rediss://default:password@your-redis.upstash.io:6379

# ─── Turbo Remote Cache (optional — speeds up CI/CD builds) ───────────────────
# Dashboard → Settings → Tokens
TURBO_TOKEN=your-turbo-token
TURBO_TEAM=your-team-slug

# ─── WhatsApp Business API (DSA portal comms) ────────────────────────────────
# Not active in demo mode — placeholder for production wiring
# WHATSAPP_API_TOKEN=your-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-id

# ─── Bureau APIs (production only) ────────────────────────────────────────────
# All bureau pulls require DPDP-compliant granular consent recorded first.
# CIBIL_API_KEY=your-cibil-key
# EXPERIAN_API_KEY=your-experian-key
# EQUIFAX_API_KEY=your-equifax-key

# ─── KYC / DigiLocker ─────────────────────────────────────────────────────────
# DIGILOCKER_CLIENT_ID=your-client-id
# DIGILOCKER_CLIENT_SECRET=your-client-secret

# ─── Internal ─────────────────────────────────────────────────────────────────
# Set to "production" on Vercel automatically
NODE_ENV=production
