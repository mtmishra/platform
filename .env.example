# LeapMoney Platform — Environment Variables Reference
# Copy this file to .env.local in each app directory and fill in real values.
# NEVER commit .env.local files.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Database ────────────────────────────────────────────────────────────────
# Direct PostgreSQL connection (server-side only, never expose to client)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used for session management, caching, and rate limiting
REDIS_URL=redis://localhost:6379

# ─── Site ────────────────────────────────────────────────────────────────────
# Public base URL used for canonical tags, OG URLs, and sitemap/robots.
NEXT_PUBLIC_SITE_URL=https://leapmoney.net

# ─── Analytics ───────────────────────────────────────────────────────────────
# Found in: Google Analytics > Admin > Data Streams > Measurement ID
# Client-side (GA4) requires the NEXT_PUBLIC_ prefix. Leave unset to disable analytics.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Payments ────────────────────────────────────────────────────────────────
# Found in: Razorpay Dashboard > Settings > API Keys
# Use test keys (rzp_test_*) for development, live keys (rzp_live_*) for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET is server-side only — never prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
